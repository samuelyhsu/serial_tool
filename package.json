{
  "name": "web-serial-tool",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Browser-based serial port tool built on the Web Serial API",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/vscode"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && npm --prefix apps/vscode run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"apps/vscode/**/*.{ts,tsx,css,mjs}\" \"*.{json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"apps/vscode/**/*.{ts,tsx,css,mjs}\" \"*.{json,md}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build:vscode": "npm --prefix apps/vscode run build",
    "package:vscode": "npm --prefix apps/vscode run package",
    "test:vscode": "npm --prefix apps/vscode run test:integration",
    "test:hardware": "vitest run apps/vscode/src/host/serialLoopback.test.ts"
  },
  "dependencies": {
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.19.21",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/w3c-web-serial": "1.0.8",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "3.2.6",
    "eslint": "10.4.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.2",
    "globals": "17.6.0",
    "jsdom": "29.1.1",
    "prettier": "3.8.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.61.0",
    "vite": "6.4.3",
    "vitest": "3.2.6"
  }
}
